# Local development defaults. Do not put a real secret in this file.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Only the text True enables the HTTPS redirect, secure cookies, and HSTS.
USE_HTTPS=False
# Comma-separated browser origins. Leave this empty to allow no cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Leave blank to use Django's local-memory cache.
# A Redis server URL has no password here, for example redis://127.0.0.1:6379/0
REDIS_URL=
# Leave blank to run Celery tasks in-process. A worker broker has no password
# here, for example redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
# Blank uses 60/minute for anonymous clients and 240/minute for authenticated
# users. Counters use the Django cache. Set REDIS_URL when multiple workers
# should share those counters.
ANON_THROTTLE_RATE=
USER_THROTTLE_RATE=
